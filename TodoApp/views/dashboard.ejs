<%- include('partials/header') %>

<div class="page-wrapper">
  <div class="container-fluid px-4 py-4">

    <div class="page-header mb-4">
      <h1 class="page-title">Dashboard</h1>
      <p class="page-subtitle">Track and manage your tasks in real time</p>
    </div>

    <div class="row g-3 mb-5">
      <div class="col-6 col-md-3">
        <div class="stat-card stat-total">
          <div class="stat-number"><%= stats.total %></div>
          <div class="stat-label">Total Tasks</div>
          <div class="stat-bar"></div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-card stat-pending">
          <div class="stat-number"><%= stats.pending %></div>
          <div class="stat-label">Pending</div>
          <div class="stat-bar"></div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-card stat-progress">
          <div class="stat-number"><%= stats.inProgress %></div>
          <div class="stat-label">In Progress</div>
          <div class="stat-bar"></div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-card stat-done">
          <div class="stat-number"><%= stats.completed %></div>
          <div class="stat-label">Completed</div>
          <div class="stat-bar"></div>
        </div>
      </div>
    </div>

    <div class="table-panel">
      <div class="table-panel-header">
        <span class="table-title">All Tasks</span>
        <a href="/add-task" class="btn-new-task">+ Add Task</a>
      </div>

      <% if (tasks.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">[ ]</div>
        <p>No tasks yet. Create your first task.</p>
        <a href="/add-task" class="btn-new-task">+ Add Task</a>
      </div>
      <% } else { %>
      <div class="table-responsive">
        <table class="table task-table">
          <thead>
            <tr>
              <th>#ID</th>
              <th>Title</th>
              <th>Description</th>
              <th>Priority</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% tasks.forEach(task => { %>
            <tr class="task-row">
              <td class="task-id">#<%= task.id %></td>
              <td class="task-title-cell"><%= task.title %></td>
              <td class="task-desc"><%= task.description %></td>
              <td>
                <span class="priority-badge priority-<%= task.priority.toLowerCase() %>"><%= task.priority %></span>
              </td>
              <td>
                <span class="status-badge status-<%= task.status.toLowerCase().replace(' ', '-') %>"><%= task.status %></span>
              </td>
              <td class="actions-cell">
                <a href="/edit-task/<%= task.id %>" class="btn-action btn-edit">Edit</a>

                <% if (task.status !== 'Completed') { %>
                <form action="/status/<%= task.id %>" method="POST" class="d-inline">
                  <button type="submit" class="btn-action btn-advance">
                    <% if (task.status === 'Pending') { %>Start<% } else { %>Done<% } %>
                  </button>
                </form>
                <% } %>

                <form action="/delete-task/<%= task.id %>" method="POST" class="d-inline" onsubmit="return confirm('Delete this task?')">
                  <button type="submit" class="btn-action btn-delete">Delete</button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>

  </div>
</div>

<%- include('partials/footer') %>
